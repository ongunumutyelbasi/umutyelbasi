---
import Layout from '../layouts/Layout.astro';
import { Certifications } from '../data/certifications';
const base = "/umutyelbasi";
import { FileUser, Download, Mail } from '@lucide/astro';

const education = [
    {
        year: "Sep 2023 — Sep 2024",
        degree: "MSc Sound Design and Audiovisual Practice",
        school: "University of Glasgow",
        description: `I completed my MSc in Sound Design and Audiovisual Practice at the University of Glasgow to get a more focused and specialised education on the areas of sound engineering that I'm interested in. My final project was based on the concept of cymatics, and my write-up can be found in my portfolio.`
    },
    {
        year: "Sep 2020 — Jul 2023",
        degree: "BSc Sound Engineering and Production",
        school: "University of Salford",
        description: `I graduated from a three-year Bachelor of Science course in Sound Engineering and Production in June 2023. Modules I took include spatial audio, studio production, game audio design and sound design for visual media. My final project and thesis was on the development of recording and production technologies from the 1960s to the 2020s.`
    },
    {
        year: "June-July 2017",
        degree: "Five-Week Music Performance Intensive",
        school: "Berklee College of Music",
        description: `During this five-week program, I worked with amazing musicians, attended lectures and workshops on jazz harmony, jazz theory, and jazz history, sang in the 5-week choir, and played piano with two ensembles at the final concert series.`
    },
    {
        year: "2012 — 2017",
        degree: "Part-time Piano & Solfege Program",
        school: "Mimar Sinan Fine Arts University State Conservatory, Istanbul",
        description: `Following advice from Turkish jazz pianist Kerem Gorsev, I entered and passed the entrance exam for the conservatory and had a chance to work with assistant professor Birce Aslan Asman until my graduation in 2017.`
    },
];

---

<Layout title="Umut Yelbaşı - Sound Engineer">
	<header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-12">
        <h2 class="text-4xl font-semibold tracking-tight text-zinc-900 mb-0">About</h2>
        
        <div class="flex gap-3">
            <a 
                href="/umutyelbasi/umut-yelbasi_cv.pdf"
                download="Umut_Yelbasi_CV.pdf"
                class="inline-flex items-center gap-2 px-4 py-2 bg-white hover:bg-sky-600 border border-sky-600 text-sky-600 hover:text-white rounded-full text-xs font-semibold uppercase tracking-regular transition-all"
            >
                <FileUser class="w-4 h-4"/> Download CV
            </a>
            <a 
                href="mailto:umutyelbasi@gmail.com"
                class="inline-flex items-center gap-2 px-4 py-2 bg-white hover:bg-sky-600 border border-sky-600 text-sky-600 hover:text-white rounded-full text-xs font-semibold uppercase tracking-regular transition-all"
            >
                <Mail class="w-4 h-4"/> Send me an email
            </a>
        </div>
    </header>

	<section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-12 items-stretch"> 
		<div class="relative bg-zinc-200 overflow-hidden rounded-sm shadow-sm min-h-[400px] lg:min-h-0"> 
			<img 
				src="/umutyelbasi/images/XmasConcert2023-5.JPEG"
				alt="Umut Yelbaşı" 
				class="absolute inset-0 w-full h-full object-cover transition-all duration-700" 
			/>
		</div>
		
		<div class="space-y-6 py-0"> 
			<div class="space-y-4 text-zinc-600 leading-relaxed text-md font-light">
				<p class="mb-6">
					I'm a detail-oriented, dedicated sound engineer, specialising in a range of sound-related areas including live sound, post-production and music production. With a foundation in classical music, I take a methodical and open-minded approach to every project, ensuring each piece of work reaches its full technical and creative potential.
				</p>
				<p class="mb-6">
					My experience in the industry began in Istanbul, assisting with the microphone setup for Mor ve Ötesi's symphonic concert at the Hagia Irene. Since then, I have spent over eight years refining my craft across various music and sound technologies.
				</p>
				<p class="mb-6">
					After completing a BSc in Sound Engineering and Production at the University of Salford, I earned an MSc in Sound Design and Audiovisual Practice from the University of Glasgow. I am currently based in Salford, Greater Manchester, where I work on freelance audio projects alongside my own personal music, which is available on all major streaming platforms.
				</p>
				<p class="mb-0">
					I am always interested in collaborating on creative projects that require a disciplined and passionate approach to sound.
				</p>
			</div>
		</div>
	</section>

	<div class="mb-6">
		<h3 class="text-2xl font-semibold tracking-tight text-zinc-900">Certifications</h3>
	</div>
	
	<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
		{Certifications.map(({ image, title, company, type }) => (
			<div class="group">
				<div class="aspect-[1.414/1] bg-zinc-200 overflow-hidden rounded-sm mb-3 border border-sky-500">
					<img 
						src={image} 
						alt={`${title} - ${company}`} 
						class="w-full h-full object-cover transition-transform duration-500"
					/>
				</div>
				<h4 class="text-md font-semibold text-zinc-900 uppercase tracking-regular mb-1 leading-[1.2]">{title}</h4>
				<p class="text-sm font-semibold text-sky-500 tracking-wide mb-1">{type}</p>
                <p class="italic font-regular text-xs text-zinc-500 tracking-wide">{company}</p>
			</div>
		))}
	</section>

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12 items-stretch"> 
        <!-- Left Column (sets the height) -->
        <div class="space-y-0 ml-2">
            <h3 class="text-xl font-semibold tracking-tight text-zinc-900 uppercase mb-8">Education</h3>
            {education.map((item) => (
                <div class="relative group border-l border-zinc-300 pl-8 pb-10 last:border-transparent">
                    <div class="absolute -left-[4.5px] top-1.5 w-2 h-2 rounded-full bg-zinc-300 ring-4 ring-zinc-50 transition-colors duration-300" />
                    <div class="flex flex-col gap-1">
                        <div class="flex flex-wrap items-baseline gap-x-3">
                            <span class="text-[12px] font-regular text-sky-600 uppercase tracking-widest">{item.year}</span>
                            <span class="text-[12px] font-semibold text-zinc-500 uppercase tracking-wide">{item.school}</span>
                        </div>
                        <h4 class="text-lg font-semibold text-zinc-900 leading-snug">{item.degree}</h4>
                        <p class="text-sm text-zinc-500 leading-relaxed max-w-2xl font-light">{item.description}</p>
                    </div>
                </div>
            ))}
        </div>

        <!-- Right Column (matches the height) -->
        <div class="hidden lg:block self-stretch">
            <div class="h-full w-full ml-auto overflow-hidden rounded-sm bg-zinc-100 border border-zinc-200">
                <img 
                    src="/umutyelbasi/images/Guitar-1.png"
                    alt="Umut Yelbaşı at the University of Salford Studios" 
                    class="w-full h-full object-cover object-right transition-all duration-700"
                />
            </div>
        </div>
    </section>

</Layout>