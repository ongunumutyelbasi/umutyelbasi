---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
const currentYear = new Date().getFullYear();

const base = import.meta.env.BASE_URL;

const currentPath = Astro.url.pathname;

// Helper to check if the link is active
// We trim trailing slashes to ensure /about/ and /about match
const isActive = (path: string) => {
    // 1. Remove trailing slashes from the current URL for a clean comparison
    const currentPath = pathname.replace(/\/$/, "");
    
    // 2. Build the target path (e.g., "/umutyelbasi/about")
    // If the path is '/', we just use the base.
    const targetPath = path === '/' ? base : `${base}${path}`;
    
    // 3. Remove trailing slash from target path and compare
    return currentPath === targetPath.replace(/\/$/, "");
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;600;800&display=swap" rel="stylesheet">
	</head>
	<body class="font-['Golos_Text',_sans-serif]">
		<div class="flex min-h-screen">
			<aside class="w-40 h-screen bg-white border-r border-zinc-200 fixed left-0 top-0 px-6 py-12 flex flex-col justify-between z-50">
				<div>
					<h1 class="text-2xl font-semibold text-sky-600 tracking-tight leading-[1.1] mb-1">Umut Yelbaşı</h1>
                    <h2 class="text-sm font-medium text-zinc-600 tracking-tight mb-8">Sound Engineer</h2>
					<nav class="space-y-4">
                        <a 
                            href={`${base}/`}
                            class:list={[
                            "block text-sm font-semibold transition-colors w-fit",
                            isActive('/') ? "text-sky-600" : "text-zinc-400 hover:text-zinc-900"
                            ]}
                        >
                            Portfolio
                        </a>

                        <a 
                            href={`${base}/about`}
                            class:list={[
                            "block text-sm font-semibold transition-colors w-fit",
                            isActive('/about') ? "text-sky-600" : "text-zinc-400 hover:text-zinc-900"
                            ]}
                        >
                            About
                        </a>

                        <a 
                            href={`${base}/contact`}
                            class:list={[
                            "block text-sm font-semibold transition-colors w-fit",
                            isActive('/contact') ? "text-sky-600" : "text-zinc-400 hover:text-zinc-900"
                            ]}
                        >
                            Contact
                        </a>
                    </nav>
				</div>
				
				<div class="text-xs text-zinc-400 tracking-regular">
					<p>&copy; {currentYear}<br>Umut Yelbaşı</p>
					<br>
                    <p>Built with Astro & Tailwind</p>
				</div>
			</aside>

			<main class="bg-zinc-50 flex-1 ml-40 p-12 lg:p-12">
				<slot />
			</main>
		</div>
	</body>
</html>