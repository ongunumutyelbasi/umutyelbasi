---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
const currentYear = new Date().getFullYear();

const base = import.meta.env.BASE_URL;

// 1. Rename 'currentPath' to 'pathname' so the function can see it
const pathname = Astro.url.pathname;

// Helper to check if the link is active
const isActive = (path: string) => {
    // 2. This now matches the variable name above
    const current = pathname.replace(/\/$/, "");
    
    // 3. Ensure the target path handles the base folder correctly
    const target = path === '/' ? base : `${base}${path}`;
    
    return current === target.replace(/\/$/, "");
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;600;800&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">

        <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
        <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
            onload="renderMathInElement(document.body, {
                delimiters: [
                    {left: '$$', right: '$$', display: true},
                    {left: '$', right: '$', inline: true}
                ]
            });">
        </script>
	</head>
	<body class="font-['Golos_Text',_sans-serif]">
		<div class="flex min-h-screen">
			<aside class="w-40 h-screen bg-white border-r border-zinc-200 fixed left-0 top-0 px-6 py-12 flex flex-col justify-between z-50">
				<div>
					<a href={`${base}/`}>
                        <h1 class="text-2xl font-semibold text-sky-600 tracking-tight leading-[1.1] mb-1">Umut Yelbaşı</h1>
                        <h2 class="text-sm font-medium text-zinc-600 tracking-tight mb-8">Sound Engineer</h2>
                    </a>
					<nav class="space-y-4">
                        <a 
                            href={`${base}/`}
                            class:list={[
                            "block text-sm font-medium transition-colors w-fit",
                            isActive('/') ? "text-sky-600" : "text-zinc-500 hover:text-zinc-900"
                            ]}
                        >
                            Portfolio
                        </a>

                        <a 
                            href={`${base}/about`}
                            class:list={[
                            "block text-sm font-medium transition-colors w-fit",
                            isActive('/about') ? "text-sky-600" : "text-zinc-500 hover:text-zinc-900"
                            ]}
                        >
                            About
                        </a>

                        <a 
                            href={`${base}/sample-mixes`}
                            class:list={[
                            "block text-sm font-medium transition-colors w-fit",
                            isActive('/sample-mixes') ? "text-sky-600" : "text-zinc-500 hover:text-zinc-900"
                            ]}
                        >
                            Sample Mixes
                        </a>

                        <a 
                            href={`${base}/contact`}
                            class:list={[
                            "block text-sm font-medium transition-colors w-fit",
                            isActive('/contact') ? "text-sky-600" : "text-zinc-500 hover:text-zinc-900"
                            ]}
                        >
                            Contact
                        </a>
                    </nav>
				</div>
				
				<div class="text-xs tracking-regular">
                    <p class="text-zinc-500 mb-2">&copy; {currentYear}<br>Umut Yelbaşı</p>
                    <p class="text-zinc-400">All Rights Reserved</p>
				</div>
			</aside>

			<main class="bg-zinc-50 flex-1 ml-40 p-12 lg:p-12">
				<slot />
			</main>
		</div>
	</body>
</html>